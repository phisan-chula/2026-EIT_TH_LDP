# -*- coding: utf-8 -*-
"""
PROGRAM: QAQC_LDP_TestLine.py
Description: Quality Control module to validate custom LDP parameters vs Ground and UTM.
"""

import math
import json
import warnings
from pathlib import Path
from dataclasses import dataclass
from typing import Dict, Optional, Tuple, Any, List

import numpy as np
import pandas as pd
import geopandas as gpd
from shapely.geometry import Point, LineString

import pyproj
import rasterio
import pygeodesy as pgd


@dataclass
class Config:
    """Centralized configuration and constants for the pipeline."""
    GADM_PATH: Path = Path('OUTPUT_PROV/gadm41_THA.gpkg')
    DEM_PATH: Path = Path('DATA/FABDEM_Thailand.vrt')
    OUT_DIR: Path = Path('OUTPUT_LDP')
    SAMPL_DIR: Path = Path('OUTPUT_SAMPL')
    FORCE_PNT_PATH: Path = Path('DATA/ForceTestPnt.gpkg')
    TGM_2017_PATH: Path = Path('/usr/share/GeographicLib/geoids/tgm2017-1.pgm')
    TEST_LINE_LENGTH_M: float = 1000.000
    GITHUB_REPO_URL: str = "https://github.com/phisan-chula/2026-EIT_TH_LDP/blob/main/src"


def extract_ldp_definitions(sampl_dir: Path, out_dir: Path) -> None:
    """
    Scans pipeline logs for LDP JSONL definitions and extracts 
    the Decimal PROJ strings into .PJ4 files.
    """
    print("Scanning pipeline logs for LDP PROJ definitions...")
    log_files = list(sampl_dir.glob("*/*_pipeline.log"))
    
    if not log_files:
        print(f"  -> No pipeline logs found in {sampl_dir}")
        return

    extracted_count = 0
    for log_file in log_files:
        hasc_safe = log_file.parent.name 
        
        try:
            with open(log_file, 'r', encoding='utf-8') as f:
                for line in f:
                    if '{"meta": "LDP_Definition"' in line:
                        data = json.loads(line.strip())
                        proj_decimal = data.get("PROJ_String_Decimal")
                        
                        if proj_decimal:
                            prov_dir = out_dir / hasc_safe
                            prov_dir.mkdir(parents=True, exist_ok=True)
                            
                            pj4_path = prov_dir / f"{hasc_safe}_LDP_CRS.PJ4"
                            pj4_path.write_text(proj_decimal, encoding='utf-8')
                            
                            extracted_count += 1
                            break  # Move to the next log file once found
        except json.JSONDecodeError:
            print(f"  -> Error parsing JSON in {log_file}")
        except Exception as e:
            print(f"  -> Unexpected error reading {log_file}: {e}")
                        
    print(f"Extracted {extracted_count} LDP definitions to {out_dir}\n")


class LDPValidator:
    def __init__(self, config: Config, force_points: Optional[Dict[str, Point]] = None):
        """Initialize the validator with configs, geodesic models, and forced points."""
        self.cfg = config
        self.cfg.OUT_DIR.mkdir(parents=True, exist_ok=True)
        
        self.geod = pyproj.Geod(ellps='WGS84')
        self.ellps = pgd.datums.Ellipsoids.WGS84
        self.geoid = self._init_geoid()
        
        # Store forced geometries and track which ones were utilized
        self.force_points: Dict[str, Point] = force_points or {}
        self.used_force_points: set = set()
        
    def _init_geoid(self) -> pgd.geoids.GeoidKarney:
        """Initialize the TGM2017 Geoid model, falling back to local path if needed."""
        print("Loading TGM2017 Geoid model...")
        if self.cfg.TGM_2017_PATH.is_file():
            return pgd.geoids.GeoidKarney(str(self.cfg.TGM_2017_PATH))
            
        fallback_path = Path(__file__).resolve().parent / "tgm2017-1.pgm"
        return pgd.geoids.GeoidKarney(str(fallback_path))

    def _get_elevations(self, src: rasterio.DatasetReader, coords: List[Tuple[float, float]]) -> Tuple[float, float]:
        """Extract orthometric heights from the DEM raster."""
        try:
            elevs = list(src.sample(coords))
            return float(elevs[0][0]), float(elevs[1][0])
        except Exception as e:
            raise ValueError(f"DEM sampling failed: {e}")

    def _calc_utm_parameters(self, lon1: float, lat1: float, lon2: float, lat2: float) -> Tuple[float, float, float, float, str]:
        """Calculate UTM grid distance, average PSF, individual PSFs, and the EPSG zone."""
        utm_crs_info = pyproj.database.query_utm_crs_info(
            datum_name="WGS 84", 
            area_of_interest=pyproj.aoi.AreaOfInterest(lon1, lat1, lon1, lat1)
        )[0]
        utm_proj = pyproj.CRS.from_epsg(utm_crs_info.code)
        utm_zone_number = str(utm_crs_info.code)[-2:]
        
        transformer_utm = pyproj.Transformer.from_crs("EPSG:4326", utm_proj, always_xy=True)
        utm1_e, utm1_n = transformer_utm.transform(lon1, lat1)
        utm2_e, utm2_n = transformer_utm.transform(lon2, lat2)
        
        L3_UTM = math.hypot(utm2_e - utm1_e, utm2_n - utm1_n)
        
        utm_proj_obj = pyproj.Proj(utm_proj)
        psf1 = utm_proj_obj.get_factors(lon1, lat1).meridional_scale
        psf2 = utm_proj_obj.get_factors(lon2, lat2).meridional_scale
        psf_avg = (psf1 + psf2) / 2.0
        
        return L3_UTM, psf_avg, psf1, psf2, utm_zone_number

    def _calc_ldp_parameters(self, hasc_safe: str, lon1: float, lat1: float, lon2: float, lat2: float) -> Tuple:
        """Calculate LDP grid distance, point scale factors, definition, and coordinates."""
        pj4_path = self.cfg.OUT_DIR / hasc_safe / f"{hasc_safe}_LDP_CRS.PJ4"
        
        if not pj4_path.exists():
            print(f"  -> WARNING: {pj4_path} not found. L6 will be NaN.")
            return (np.nan, np.nan, np.nan, np.nan, "Not found", (np.nan, np.nan), (np.nan, np.nan))
            
        ldp_proj_str = pj4_path.read_text(encoding='utf-8').strip()
        ldp_crs = pyproj.CRS(ldp_proj_str)
        
        transformer_ldp = pyproj.Transformer.from_crs("EPSG:4326", ldp_crs, always_xy=True)
        ldp1_e, ldp1_n = transformer_ldp.transform(lon1, lat1)
        ldp2_e, ldp2_n = transformer_ldp.transform(lon2, lat2)
        
        ldp_distance = math.hypot(ldp2_e - ldp1_e, ldp2_n - ldp1_n)
        ldp_proj_obj = pyproj.Proj(ldp_crs)
        
        ldp_psf1 = ldp_proj_obj.get_factors(lon1, lat1).meridional_scale
        ldp_psf2 = ldp_proj_obj.get_factors(lon2, lat2).meridional_scale
        ldp_psf_avg = (ldp_psf1 + ldp_psf2) / 2.0

        return (
            ldp_distance, ldp_psf_avg, ldp_psf1, ldp_psf2,
            ldp_proj_str, (ldp1_e, ldp1_n), (ldp2_e, ldp2_n)
        )

    def process_province(self, row: pd.Series, src: rasterio.DatasetReader) -> Optional[Dict[str, Any]]:
        """Process a single province boundary to compute all test distances."""
        hasc = row.get('HASC_1')
        if not hasc or pd.isna(hasc): 
            return None
            
        hasc_safe = str(hasc).replace('.', '_').upper()
        name_1 = row.get('NAME_1', 'Unknown')
        
        # 1. Coordinate Determination (Forced vs Centroid)
        if hasc in self.force_points:
            p1_geom = self.force_points[hasc]
            self.used_force_points.add(hasc)
            lon1, lat1 = p1_geom.x, p1_geom.y
            print(f"  -> 🎯 ForcePoint overridden for {hasc_safe} ({name_1}) at ({lon1:.6f}, {lat1:.6f})")
        else:
            with warnings.catch_warnings():
                warnings.simplefilter("ignore", UserWarning)
                p1_geom = row.geometry.representative_point()
            lon1, lat1 = p1_geom.x, p1_geom.y
        
        # 2. Forward Geodesic projection
        L1 = self.cfg.TEST_LINE_LENGTH_M
        lon2, lat2, _ = self.geod.fwd(lon1, lat1, 0, L1)
        
        # 3. Heights and Geoid
        try:
            H1, H2 = self._get_elevations(src, [(lon1, lat1), (lon2, lat2)])
        except ValueError as e:
            print(f"  -> Skipping {hasc_safe}: {e}")
            return None
            
        N1, N2 = self.geoid.height(lat1, lon1), self.geoid.height(lat2, lon2)
        h1, h2 = H1 + N1, H2 + N2
        
        H_avg, N_avg = (H1 + H2) / 2.0, (N1 + N2) / 2.0
        h_avg = H_avg + N_avg
        
        # 4. Height Scale Factor & Ground Distance
        RG1 = self.ellps.rocGauss(lat1)
        RG2 = self.ellps.rocGauss(lat2)
        HSF1, HSF2 = RG1 / (RG1 + h1), RG2 / (RG2 + h2)
        
        avg_lat = (lat1 + lat2) / 2.0
        HSF = self.ellps.rocGauss(avg_lat) / (self.ellps.rocGauss(avg_lat) + h_avg)
        L2 = L1 / HSF
        
        # 5. UTM Distance & Combined Scale Factors
        L3, PSF_avg, PSF1, PSF2, utm_zone = self._calc_utm_parameters(lon1, lat1, lon2, lat2)
        L4 = L3 / PSF_avg
        UTM_CSF_avg = PSF_avg * HSF
        L5 = L3 / UTM_CSF_avg

        # 6. LDP Parameters
        (
            L6, LDP_PSF_avg, LDP_PSF1, LDP_PSF2,
            ldp_def, p1_ldp, p2_ldp
        ) = self._calc_ldp_parameters(hasc_safe, lon1, lat1, lon2, lat2)

        LDP_CSF1 = LDP_PSF1 * HSF1 if np.isfinite(LDP_PSF1) else np.nan
        LDP_CSF2 = LDP_PSF2 * HSF2 if np.isfinite(LDP_PSF2) else np.nan
        LDP_CSF_avg = LDP_PSF_avg * HSF if np.isfinite(LDP_PSF_avg) else np.nan
        
        return {
            'HASC_1': hasc, 'NAME_1': name_1, 'Province_Code': hasc_safe,
            'lat1': lat1, 'lon1': lon1, 'lat2': lat2, 'lon2': lon2,
            'H_Orthometric': H_avg, 'N_Undulation': N_avg, 'h_Ellipsoidal': h_avg, 'HSF': HSF,
            'UTM_Zone': utm_zone, 'UTM_PSF': PSF_avg, 'UTM_CSF': UTM_CSF_avg,
            'UTM_CSF1': PSF1 * HSF1, 'UTM_CSF2': PSF2 * HSF2,
            'LDP_PSF': LDP_PSF_avg, 'LDP_PSF1': LDP_PSF1, 'LDP_PSF2': LDP_PSF2,
            'LDP_CSF': LDP_CSF_avg, 'LDP_CSF1': LDP_CSF1, 'LDP_CSF2': LDP_CSF2,
            'L1_Ellps': L1, 'L2_Grnd': L2, 'L3_UTM': L3, 'L4_UTM2Ellps': L4, 'L5_UTM2Grnd': L5, 'L6_LDP': L6,
            'LDP_Def': ldp_def, 'P1_LDP': p1_ldp, 'P2_LDP': p2_ldp,
            'diff_L1': L1 - L2, 'diff_L2': 0.000, 'diff_L3': L3 - L2,
            'diff_L4': L4 - L2, 'diff_L5': L5 - L2, 'diff_L6': L6 - L2,
            'geometry': LineString([Point(lon1, lat1), Point(lon2, lat2)])
        }

    def write_geopackages(self, df_results: pd.DataFrame) -> None:
        """Export individual province Geopackages."""
        print(f"\nSaving generated test lines to Geopackages...")
        gdf_results = gpd.GeoDataFrame(df_results, geometry='geometry', crs="EPSG:4326")
        
        for hasc_safe, group in gdf_results.groupby('Province_Code'):
            prov_dir = self.cfg.OUT_DIR / hasc_safe
            prov_dir.mkdir(parents=True, exist_ok=True)
            out_gpkg = prov_dir / f"{hasc_safe}_TestLine.gpkg"
            group.to_file(out_gpkg, driver='GPKG', layer='QAQC_Line')

    def write_markdown_report(self, df_results: pd.DataFrame, df_line_descr: pd.DataFrame) -> None:
        """Generate the final README.md summary report using formatted templates."""
        print("Generating Summary in OUTPUT_LDP/README.md ...")
        md_path = self.cfg.OUT_DIR / 'README.md'
        
        md_content = [
            "# LDP Quality Control & Validation Summary\n",
            "This report provides a comparative analysis of distances calculated across various map projections and surfaces. By establishing the **Ground Distance (L2)** as the true baseline of length 1,000.000 meter, we measure the linear distortion introduced by standard UTM grids against the custom Low Distortion Projections (LDP).\n",
            "## --- Distance Definitions ---\n",
            f"{df_line_descr.to_markdown(index=False)}\n"
        ]

        for _, res in df_results.iterrows():
            hasc_safe = res['Province_Code']
            
            # Format Coordinates & Values
            p1_str, p2_str = f"({res['lat1']:.9f}, {res['lon1']:.9f})", f"({res['lat2']:.9f}, {res['lon2']:.9f})"
            msl_val, hae_val = int(round(res['H_Orthometric'])), int(round(res['h_Ellipsoidal']))
            
            p1_ldp = res.get('P1_LDP', (np.nan, np.nan))
            p2_ldp = res.get('P2_LDP', (np.nan, np.nan))
            p1_ldp_str = "(NaN, NaN)" if pd.isna(p1_ldp[0]) else f"({p1_ldp[0]:.3f}, {p1_ldp[1]:.3f})"
            p2_ldp_str = "(NaN, NaN)" if pd.isna(p2_ldp[0]) else f"({p2_ldp[0]:.3f}, {p2_ldp[1]:.3f})"
            
            # Format Scale Factors
            csf1_ppm, csf2_ppm = (res['LDP_CSF1'] - 1.0) * 1e6, (res['LDP_CSF2'] - 1.0) * 1e6
            flag1, flag2 = (" ❗" if abs(csf1_ppm) > 20 else ""), (" ❗" if abs(csf2_ppm) > 20 else "")
            
            utm_csf1_ppm, utm_csf2_ppm = (res['UTM_CSF1'] - 1.0) * 1e6, (res['UTM_CSF2'] - 1.0) * 1e6
            u_zone_label = f"U{res.get('UTM_Zone', 'TM')}"
            diff_l6_str = "NaN" if pd.isna(res['diff_L6']) else f"{res['diff_L6']:+.3f}"
            
            # Form URLs dynamically
            wkt_url = f"{self.cfg.GITHUB_REPO_URL}/OUTPUT_LDP/{hasc_safe}/{hasc_safe}_LDP_CRS.WKT"
            pj4_url = f"{self.cfg.GITHUB_REPO_URL}/OUTPUT_LDP/{hasc_safe}/{hasc_safe}_LDP_CRS.PJ4"

            # Create the exact clean slug target requested by the user
            hasc_clean = str(res['HASC_1']).lower().replace('.', '')
            anchor_slug = f"-{hasc_clean}--wkt---proj4"

            # Render province block template with injected <a id="...">
            province_block = f"""---

### <a id="{anchor_slug}"></a>🧭 {res['NAME_1']} <span style="float: right;">📄 [WKT]({wkt_url}) &emsp; 🌐 [PROJ4]({pj4_url})</span>

> **{res['HASC_1']} LDP :**
> `{res['LDP_Def']}`

| P1 | {p1_str} | P2 | {p2_str} |
|:---|:---|:---|:---|
| MSL | {msl_val} | HAE | {hae_val} |
| P1_LDP | {p1_ldp_str} | P2_LDP | {p2_ldp_str} |
| P1_LDP_CSF | {csf1_ppm:+.1f} ppm{flag1} | P2_LDP_CSF | {csf2_ppm:+.1f} ppm{flag2} |
| P1_{u_zone_label}_CSF | {utm_csf1_ppm:+.1f} ppm | P2_{u_zone_label}_CSF | {utm_csf2_ppm:+.1f} ppm |

| ΔL1_ELLP | ΔL2_GRND | ΔL3_UTM | ΔL4_UTM_PSF | ΔL5_UTM_CSF | ΔL6_LDP |
|:---:|:---:|:---:|:---:|:---:|:---:|
| {res['diff_L1']:+.3f} | *0.000 | {res['diff_L3']:+.3f} | {res['diff_L4']:+.3f} | {res['diff_L5']:+.3f} | {diff_l6_str} |
"""
            md_content.append(province_block)

        md_path.write_text("\n".join(md_content), encoding='utf-8')


def generate_line_descriptions(out_dir: Path) -> pd.DataFrame:
    """Generate and save the line descriptions lookup table."""
    df = pd.DataFrame({
        'Line': ['L1', 'L2', 'L3', 'L4', 'L5', 'L6'],
        'Line Description': [
            'on the ellipsoid surface',
            'on the ground surface , (HSF applied)', 
            'on the UTM grid',
            'on the UTM grid (PSF applied)',
            'on the UTM grid (CSF applied)',
            'on the LDP grid'
        ]
    })
    df.to_csv(out_dir / 'Line_Descriptions.csv', index=False)
    return df


def load_forced_points(force_pnt_path: Path) -> Dict[str, Point]:
    """Load forced test points into a dictionary mapping HASC_1 to geometry."""
    force_dict: Dict[str, Point] = {}
    if force_pnt_path.exists():
        print(f"Loading forced test points from {force_pnt_path}...")
        gdf_force = gpd.read_file(force_pnt_path, layer='ForceTestPnt')
        
        if gdf_force.crs and gdf_force.crs.to_epsg() != 4326:
            gdf_force = gdf_force.to_crs("EPSG:4326")
            
        for _, row in gdf_force.iterrows():
            if pd.notna(row.get('HASC_1')) and row.geometry:
                force_dict[row['HASC_1']] = row.geometry
                
        print(f"  -> Found {len(force_dict)} force points to potentially override.")
    return force_dict


def main() -> None:
    cfg = Config()
    
    # 0. Extract PROJ Strings from logs before running the validator
    extract_ldp_definitions(cfg.SAMPL_DIR, cfg.OUT_DIR)
    
    # 0.5. Load forced points
    force_dict = load_forced_points(cfg.FORCE_PNT_PATH)
    
    # 1. Initialization
    df_line_descr = generate_line_descriptions(cfg.OUT_DIR)
    validator = LDPValidator(config=cfg, force_points=force_dict)
    
    # 2. Read Province Geometries
    if not cfg.GADM_PATH.exists():
        raise FileNotFoundError(f"Cannot find province boundaries at {cfg.GADM_PATH}")
        
    print(f"Reading {cfg.GADM_PATH} (layer: ADM_ADM_1) ...")
    gdf_prov = gpd.read_file(cfg.GADM_PATH, layer='ADM_ADM_1')
    if gdf_prov.crs.to_epsg() != 4326:
        gdf_prov = gdf_prov.to_crs("EPSG:4326")

    # 3. Processing Loop
    results = []
    print(f"Processing {len(gdf_prov)} provinces ...")
    
    with rasterio.open(cfg.DEM_PATH) as src:
        for _, row in gdf_prov.iterrows():
            result = validator.process_province(row, src)
            if result:
                results.append(result)

    # 4. Validation: Verify all points from ForceTestPnt were used
    if force_dict:
        unused_points = set(force_dict.keys()) - validator.used_force_points
        if unused_points:
            print(f"\n⚠️ WARNING: ForceTestPnt geometries not mapped: {', '.join(unused_points)}")
        else:
            print("\n✅ SUCCESS: All ForceTestPnt geometries were successfully utilized.")

    # 5. Export Data and Reports
    df_results = pd.DataFrame(results)
    if not df_results.empty:
        df_results = df_results.sort_values(by='HASC_1', ascending=True).reset_index(drop=True)
        validator.write_geopackages(df_results)
        validator.write_markdown_report(df_results, df_line_descr)
        
    print("QA/QC module execution complete.")


if __name__ == "__main__":
    main()
